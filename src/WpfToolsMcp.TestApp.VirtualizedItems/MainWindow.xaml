<Window x:Class="WpfToolsMcp.TestApp.VirtualizedItems.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF Tools MCP Virtualized Items TestApp"
        Width="440"
        Height="360"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="Manual"
        Left="100"
        Top="100"
        Background="White"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Virtualized recycling list"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <ListBox x:Name="VirtualizedList"
                 Grid.Row="1"
                 Width="360"
                 Height="220"
                 HorizontalAlignment="Left"
                 AutomationProperties.AutomationId="VirtualizedItems_List"
                 ItemsSource="{Binding Items}"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.CacheLength="0"
                 VirtualizingPanel.ScrollUnit="Item"
                 SelectionChanged="VirtualizedList_SelectionChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="24" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayText}" Padding="4,2" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="SelectionStatus"
                   Grid.Row="2"
                   AutomationProperties.AutomationId="VirtualizedItems_SelectionStatus"
                   Text="Selected: (none)"
                   Margin="0,12,0,0" />
    </Grid>
</Window>
